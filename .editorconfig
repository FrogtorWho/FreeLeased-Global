# EditorConfig: keep formatting consistent across editors.
# https://editorconfig.org

root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space

[*.{ts,tsx,js,jsx,json,css,html,svg,md,yml,yaml,toml}]
indent_size = 2

[*.py]
indent_size = 4

[*.{bat,ps1}]
end_of_line = crlf

[*.{md,markdown}]
trim_trailing_whitespace = false

[package.json]
indent_size = 2
