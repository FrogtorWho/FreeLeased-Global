# FreeLeased environment template — copy to .env and replace placeholders with real values.
# All four variables below are required by the live deployment / observability stack.
NEBIUS_API_KEY=your_nebius_api_key_here
OLLYGARDEN_API_KEY=your_ollygarden_api_key_here
OLLYGARDEN_OTLP_ENDPOINT=https://in.ollygarden.cloud/v1/traces
MINIMAX_API_KEY=your_minimax_api_key_here
# Optional: when set to "1" + MINIMAX_API_KEY above is configured, the agent
# orchestrator routes LLM calls through MiniMax. With this flag unset (the
# default) the agents continue to use the deterministic simulateLLMCall path.
# See `src/lib/minimax.ts` for the dual-LLM fallback chain (Giotto → MiniMax → fallback).
USE_MINIMAX=0
MINIMAX_BASE_URL=https://api.minimax.chat/v1/

# Giotto.ai — free unlimited access for Future Caribbean participants
# Claim: email Daniel Alvarez (state "Future Caribbean participant") OR https://giotto.ai/get-started
GIOTTO_API_KEY=your_giotto_api_key_here
GIOTTO_BASE_URL=https://api.giotto.ai/v1/

# Local edge LLM (Ollama) — OpenAI-compatible, single-GPU, on-prem, $0 compute
# Primary Tier-1 path in src/lib/llm.server.ts when USE_LOCAL_EDGE=1.
# Install: see scripts/setup-local-edge.{sh,ps1}. Model card + research:
# project/research/edge-llm-research.md.
# Default model assumes a single RTX 4090 (24 GB) running 70B-class at q4_K_M.
# For a laptop with 8 GB RAM swap OLLAMA_MODEL to: phi3.5:3.8b-mini-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.3:70b-instruct-q4_K_M
USE_LOCAL_EDGE=1